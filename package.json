{
  "name": "breadesp",
  "version": "0.2.0",
  "private": true,
  "description": "ESP32 virtual breadboard simulator (PRD §1.1)",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "fetch-qemu": "node scripts/fetch-qemu.mjs",
    "pack:installer": "node scripts/build-installer.mjs",
    "create-peripheral": "pnpm --filter @breadesp/shell exec tsx src/peripherals/scaffold-cli.ts",
    "docs:build": "pnpm --filter @breadesp/docs-site exec tsx src/cli.ts build",
    "docs:check": "pnpm --filter @breadesp/docs-site exec tsx src/cli.ts check",
    "docs:serve": "pnpm --filter @breadesp/docs-site exec tsx src/cli.ts serve",
    "verify": "pnpm typecheck && pnpm test && pnpm test:scripts",
    "test:scripts": "vitest run --root scripts",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
